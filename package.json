{
  "name": "expense-tracker-api",
  "version": "1.0.0",
  "description": "A small REST API to track personal expenses",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "express",
    "sqlite",
    "expenses",
    "api"
  ],
